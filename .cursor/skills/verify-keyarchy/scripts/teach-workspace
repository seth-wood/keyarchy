#!/usr/bin/env bash
# Drive: mouse-like workspace switch should teach (no beacon).
# Usage: teach-workspace [workspace-number] [run-id]
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=common.sh
source "$SCRIPT_DIR/common.sh"

TARGET="${1:-8}"
RUN_DIR="$(new_run_dir "${2:-teach-workspace-$(date +%Y%m%d-%H%M%S)}")"
ACTION="workspace:${TARGET}"
FEATURE="teach-from-mouse"

acquire_lock
VERIFY_RUN_DIR="$RUN_DIR"
VERIFY_PANEL_OPEN=0
trap 'verify_cleanup' EXIT

"$SCRIPT_DIR/doctor" | tee "$RUN_DIR/doctor.txt"
snapshot_user_state "$RUN_DIR"

# Make this action teachable now (shared session keeps real cooldowns).
clear_action_cooldown "$ACTION"
sleep 0.4
# Global gap is 5s; wait so a prior teach does not swallow this one.
sleep 5

BEFORE=$(python3 -c "import json; print(json.load(open('$STATE_PATH')).get('counts',{}).get('$ACTION',0))")
LOG=$(qs_log)
LOG_MARK=$(wc -l <"$LOG")

echo "feature=$FEATURE action=$ACTION before_count=$BEFORE" | tee "$RUN_DIR/drive.txt"

# Mouse-equivalent path: Hyprland dispatch with no shim beacon.
hyprctl dispatch "hl.dsp.focus({ workspace = '$TARGET' })" | tee -a "$RUN_DIR/drive.txt"
sleep 1.5

AFTER=$(python3 -c "import json; s=json.load(open('$STATE_PATH')); print(s.get('counts',{}).get('$ACTION',0)); open('$RUN_DIR/state.after.json','w').write(json.dumps(s,indent=2))")
META=$(python3 -c "import json; print(json.dumps(json.load(open('$STATE_PATH')).get('meta',{}).get('$ACTION')))")

TEACH_LINE=$(tail -n +"$((LOG_MARK + 1))" "$LOG" | rg "keyarchy teach $ACTION" || true)
printf '%s\n' "$TEACH_LINE" >"$RUN_DIR/teach.log"

# Panel proof: Learned list should include this lesson.
omarchy-shell "$PLUGIN_ID" toggle | tee -a "$RUN_DIR/drive.txt"
VERIFY_PANEL_OPEN=1
sleep 0.7
OMARCHY_SCREENSHOT_DIR="$RUN_DIR" omarchy capture screenshot fullscreen save | tee -a "$RUN_DIR/drive.txt"
omarchy-shell -q "$PLUGIN_ID" toggle || true
VERIFY_PANEL_OPEN=0

{
  echo "feature=$FEATURE"
  echo "action=$ACTION"
  echo "before_count=$BEFORE"
  echo "after_count=$AFTER"
  echo "meta=$META"
  echo "teach_line=$TEACH_LINE"
  echo "run_dir=$RUN_DIR"
} | tee "$RUN_DIR/summary.txt"

[[ -n $TEACH_LINE ]] || fail "no teach log line for $ACTION"
[[ "$AFTER" -gt "$BEFORE" ]] || fail "count for $ACTION did not increase ($BEFORE -> $AFTER)"
python3 -c "import json; m=json.load(open('$RUN_DIR/state.after.json')).get('meta',{}).get('$ACTION') or {}; assert m.get('description','').startswith('Switch to workspace'), m; assert 'SUPER' in m.get('keys',''), m"

SHOT=$(ls "$RUN_DIR"/screenshot-*.png 2>/dev/null | head -1 || true)
[[ -n $SHOT ]] || fail "no screenshot captured under $RUN_DIR"
echo "proof: $RUN_DIR"
echo "screenshot: $SHOT"
