#!/usr/bin/env bash
# Drive: beacon then workspace dispatch must NOT teach (keyboard path).
# Usage: suppress-workspace [workspace-number] [run-id]
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=common.sh
source "$SCRIPT_DIR/common.sh"

TARGET="${1:-9}"
RUN_DIR="$(new_run_dir "${2:-suppress-workspace-$(date +%Y%m%d-%H%M%S)}")"
ACTION="workspace:${TARGET}"
FEATURE="suppress-on-beacon"
DESC="Switch to workspace ${TARGET}"

acquire_lock
VERIFY_RUN_DIR="$RUN_DIR"
VERIFY_PANEL_OPEN=0
trap 'verify_cleanup' EXIT

"$SCRIPT_DIR/doctor" | tee "$RUN_DIR/doctor.txt"
snapshot_user_state "$RUN_DIR"
clear_action_cooldown "$ACTION"
sleep 5

BEFORE=$(python3 -c "import json; print(json.load(open('$STATE_PATH')).get('counts',{}).get('$ACTION',0))")
USAGE_BEFORE=$(usage_count_for "$DESC")
LOG=$(qs_log)
LOG_MARK=$(wc -l <"$LOG")

# Positive keyboard signal, then the matching Hyprland event.
printf '%s\nSUPER + %s\n' "$DESC" "$TARGET" >"$BEACON_PATH"
sleep 0.15
hyprctl dispatch "hl.dsp.focus({ workspace = '$TARGET' })" | tee "$RUN_DIR/drive.txt"
sleep 1.5

AFTER=$(python3 -c "import json; s=json.load(open('$STATE_PATH')); print(s.get('counts',{}).get('$ACTION',0)); open('$RUN_DIR/state.after.json','w').write(json.dumps(s,indent=2))")
TEACH_LINE=$(tail -n +"$((LOG_MARK + 1))" "$LOG" | rg "keyarchy teach $ACTION" || true)
printf '%s\n' "$TEACH_LINE" >"$RUN_DIR/teach.log"

# Usage persists on a 5s debounce; wait for the beaconed bind to land on disk.
USAGE_HIT=$(wait_for_usage_increase "$DESC" "$USAGE_BEFORE") || fail "beacon did not count usage for '$DESC' (before=$USAGE_BEFORE after=$(usage_count_for "$DESC"))"

{
  echo "feature=$FEATURE"
  echo "action=$ACTION"
  echo "before_count=$BEFORE"
  echo "after_count=$AFTER"
  echo "teach_line=$TEACH_LINE"
  echo "usage_before=$USAGE_BEFORE"
  echo "usage_$DESC=$USAGE_HIT"
  echo "run_dir=$RUN_DIR"
} | tee "$RUN_DIR/summary.txt"

[[ -z $TEACH_LINE ]] || fail "unexpected teach for keyboard path: $TEACH_LINE"
[[ "$AFTER" -eq "$BEFORE" ]] || fail "lesson count changed on suppress ($BEFORE -> $AFTER)"
[[ "$USAGE_HIT" -gt "$USAGE_BEFORE" ]] || fail "beacon did not count usage for '$DESC'"
echo "proof: $RUN_DIR"
