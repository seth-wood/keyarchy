#!/usr/bin/env bash
# Drive: open the Keyarchy bar panel via IPC and capture a screenshot.
# Usage: open-panel [run-id]
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=common.sh
source "$SCRIPT_DIR/common.sh"

RUN_DIR="$(new_run_dir "${1:-open-panel-$(date +%Y%m%d-%H%M%S)}")"
FEATURE="bar-panel"

acquire_lock
VERIFY_RUN_DIR=""
VERIFY_PANEL_OPEN=0
trap 'verify_cleanup' EXIT

"$SCRIPT_DIR/doctor" | tee "$RUN_DIR/doctor.txt"

omarchy-shell "$PLUGIN_ID" toggle | tee "$RUN_DIR/drive.txt"
VERIFY_PANEL_OPEN=1
sleep 0.8
OMARCHY_SCREENSHOT_DIR="$RUN_DIR" omarchy capture screenshot fullscreen save | tee -a "$RUN_DIR/drive.txt"
omarchy-shell -q "$PLUGIN_ID" toggle || true
VERIFY_PANEL_OPEN=0

SHOT=$(ls "$RUN_DIR"/screenshot-*.png 2>/dev/null | head -1 || true)
[[ -n $SHOT ]] || fail "no screenshot under $RUN_DIR"

# Best-effort: OCR / file size only — panel title is not machine-readable in PNG.
# Record binds summary the panel would show.
python3 - <<PY | tee "$RUN_DIR/summary.txt"
import json, os
binds=json.load(open("$BINDS_PATH"))
usage={}
try: usage=json.load(open("$USAGE_PATH"))
except Exception: pass
used=sum(1 for d in binds if usage.get(d,0)>0)
print(f"feature=$FEATURE")
print(f"screenshot=$SHOT")
print(f"summary_text={used} of {len(binds)} shortcuts used")
print(f"run_dir=$RUN_DIR")
PY

echo "proof: $RUN_DIR"
echo "screenshot: $SHOT"
