#!/usr/bin/env bash
# Drive: unit logic (model + shim) — no live desktop required beyond lua/node.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=common.sh
source "$SCRIPT_DIR/common.sh"

RUN_DIR="$(new_run_dir "${1:-unit-logic-$(date +%Y%m%d-%H%M%S)}")"
FEATURE="unit-logic"

# Run in a subshell with its own set -e. Wrapping the group in `||` or `if`
# would suppress set -e and let later steps hide an earlier failure.
set +e
(
  set -euo pipefail
  echo "feature=$FEATURE"
  echo "cwd=$REPO_ROOT"
  cd "$REPO_ROOT"
  node --test test/model.test.mjs
  lua test/shim.test.lua
  omarchy plugin validate plugin
) >"$RUN_DIR/summary.txt" 2>&1
status=$?
set -euo pipefail

cat "$RUN_DIR/summary.txt"
echo "status=$status" | tee -a "$RUN_DIR/summary.txt"
echo "proof: $RUN_DIR"
exit "$status"
