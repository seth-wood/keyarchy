#!/usr/bin/env bash
# Read-only health check: is this Keyarchy install worth driving?
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=common.sh
source "$SCRIPT_DIR/common.sh"

ok=1
pass() { echo "ok   $*"; }
bad() { echo "FAIL $*"; ok=0; }

command -v omarchy >/dev/null || bad "omarchy not on PATH"
command -v hyprctl >/dev/null || bad "hyprctl not on PATH"
command -v omarchy-shell >/dev/null || bad "omarchy-shell not on PATH"
[[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]] || bad "HYPRLAND_INSTANCE_SIGNATURE unset (not in a Hyprland session)"

[[ -d $PLUGIN_DEST ]] || bad "plugin missing at $PLUGIN_DEST (run ./install.sh)"
[[ -f $SHIM_DEST ]] || bad "shim missing at $SHIM_DEST"
[[ -f $BINDS_PATH ]] || bad "binds.json missing at $BINDS_PATH (shim not exporting)"
[[ -f $REPO_ROOT/manifest.json ]] || bad "repo manifest missing at $REPO_ROOT"

if command -v omarchy >/dev/null; then
  if omarchy plugin list --json 2>/dev/null | python3 -c "
import json,sys
plugins=json.load(sys.stdin)
hit=[p for p in plugins if p.get('id')=='slw.keyarchy']
sys.exit(0 if hit and hit[0].get('enabled') else 1)
"; then
    pass "plugin slw.keyarchy enabled"
  else
    bad "plugin slw.keyarchy not enabled (omarchy plugin enable slw.keyarchy right)"
  fi
fi

if grep -qF 'hypr.keyarchy-shim' "${HOME}/.config/hypr/hyprland.lua" 2>/dev/null; then
  pass "hyprland.lua loads keyarchy-shim"
else
  bad "hyprland.lua does not require hypr.keyarchy-shim"
fi

bind_count=$(python3 -c "import json; print(len(json.load(open('$BINDS_PATH'))))" 2>/dev/null || echo 0)
[[ "$bind_count" -gt 50 ]] && pass "binds.json has $bind_count entries" || bad "binds.json only has $bind_count entries"

# The repo root is the plugin folder now, so compare the tracked files rather
# than the whole tree — the checkout also carries .git and untracked scratch.
drift=""
while IFS= read -r -d '' f; do
  diff -q "$REPO_ROOT/$f" "$PLUGIN_DEST/$f" >/dev/null 2>&1 || drift="$f"
done < <(git -C "$REPO_ROOT" ls-files -z ':!.cursor')
if [[ -n $drift ]]; then
  bad "installed plugin differs from repo (first: $drift) — re-run ./install.sh"
else
  pass "installed plugin matches repo"
fi

if ! diff -q "$REPO_ROOT/hypr/keyarchy-shim.lua" "$SHIM_DEST" >/dev/null 2>&1; then
  bad "installed shim differs from repo — re-run ./install.sh"
else
  pass "installed shim matches repo"
fi

LOG=$(qs_log)
if rg -q "keyarchy service-ready id=slw.keyarchy hyprland=true" "$LOG"; then
  pass "service-ready in $(basename "$(dirname "$LOG")")/log.log"
else
  bad "no keyarchy service-ready in $LOG (omarchy restart shell)"
fi

pgrep -f 'quickshell -n -p /usr/share/omarchy/shell' >/dev/null && pass "omarchy-shell (quickshell) running" || bad "quickshell not running"

echo "---"
echo "repo=$REPO_ROOT"
echo "log=$LOG"
echo "binds=$bind_count"
[[ $ok -eq 1 ]] || exit 1
echo "doctor: healthy"
